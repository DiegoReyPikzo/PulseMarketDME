{
  "name": "pulsemarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:unit": "vitest run tests/queries/unit.test.ts",
    "test:dashboard": "vitest run tests/dashboard/list-params.test.ts tests/dashboard/perf-log.test.ts tests/dashboard/loading-fallbacks.test.tsx tests/dashboard/page-fallbacks.test.tsx",
    "test:auth": "vitest run tests/auth/authorization.test.ts tests/auth/google-account-disclosure.test.ts tests/auth/same-origin-request.test.ts tests/auth/session.test.ts",
    "test:integration": "vitest run --mode integration tests/queries/integration.test.ts",
    "test:mutations:unit": "vitest run tests/catalog-mutations/unit.test.ts tests/catalog-mutations/client-validation.test.ts tests/catalog-mutations/bulk-form.test.tsx",
    "test:mutations:integration": "vitest run --mode integration tests/catalog-mutations/integration.test.ts",
    "test:analytics:unit": "vitest run tests/analytics/unit.test.ts tests/analytics/dashboard.unit.test.ts tests/analytics/analytics-prisma.unit.test.ts",
    "test:analytics:integration": "vitest run --mode integration tests/analytics/integration.test.ts",
    "test:product-creation:unit": "vitest run tests/product-creation/unit.test.ts tests/product-creation/client-validation.test.ts tests/product-creation/form.test.tsx",
    "test:product-creation:integration": "vitest run --mode integration tests/product-creation/integration.test.ts",
    "test:product-update:unit": "vitest run tests/product-update/unit.test.ts tests/product-update/client-validation.test.ts tests/product-update/edit-dialog.test.tsx",
    "test:product-update:integration": "vitest run --mode integration tests/product-update/integration.test.ts",
    "test:customers:unit": "vitest run tests/customer-mutations/unit.test.ts tests/customer-mutations/client-validation.test.ts tests/customer-mutations/forms.test.tsx",
    "test:customers:integration": "vitest run --mode integration tests/customer-mutations/integration.test.ts",
    "db:benchmark": "node --conditions=react-server --import tsx scripts/benchmark-queries.ts",
    "db:analytics-benchmark": "node --conditions=react-server --import tsx scripts/benchmark-analytics.ts",
    "e2e:config:test": "vitest run tests/e2e/environment.test.ts tests/e2e/oauth-provider.test.ts",
    "e2e:preflight": "node --import tsx scripts/e2e-preflight.ts",
    "e2e:with-env": "node --import tsx scripts/e2e-with-env.ts",
    "e2e:auth": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts",
    "e2e:google-request": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts --google-denial",
    "e2e:products": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts --products",
    "e2e:reorder": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts --reorder",
    "e2e:product-edit": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts --product-edit",
    "e2e:customers": "node --conditions=react-server --import tsx scripts/e2e-auth-runner.ts --customers",
    "test:production-tooling": "vitest run tests/production/environment.test.ts tests/production/migration-checks.test.ts tests/production/seed-v2.test.ts tests/seed/unit.test.ts",
    "prod:db": "node --import tsx scripts/production-with-env.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "24.x"
  }
}
